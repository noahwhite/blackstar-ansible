auths:
  public_v2:
    community: {{ mikrotik_snmp_community }}
    version: 2
{% if tplink_snmp_community is defined %}
  blackstar_v2:
    community: {{ tplink_snmp_community }}
    version: 2
{% endif %}

modules:
  mikrotik:
    walk:
      - 1.3.6.1.2.1.1.3
      - 1.3.6.1.2.1.2.2
      - 1.3.6.1.2.1.25.2.3
      - 1.3.6.1.2.1.25.3.3
      - 1.3.6.1.2.1.31.1.1
      - 1.3.6.1.4.1.14988.1.1.3
    metrics:
      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge
        help: System uptime in hundredths of a second.

      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: Interface operational state (1=up 2=down 3=testing).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
        enum_values:
          1: up
          2: down
          3: testing
          4: unknown
          5: dormant
          6: notPresent
          7: lowerLayerDown

      - name: ifHCInOctets
        oid: 1.3.6.1.2.1.31.1.1.1.6
        type: counter
        help: Total octets received on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHCOutOctets
        oid: 1.3.6.1.2.1.31.1.1.1.10
        type: counter
        help: Total octets transmitted on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHighSpeed
        oid: 1.3.6.1.2.1.31.1.1.1.15
        type: gauge
        help: Interface speed in Mbps.
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: hrProcessorLoad
        oid: 1.3.6.1.2.1.25.3.3.1.2
        type: gauge
        help: Processor load percentage.
        indexes:
          - labelname: hrDeviceIndex
            type: gauge

      - name: hrStorageAllocationUnits
        oid: 1.3.6.1.2.1.25.2.3.1.4
        type: gauge
        help: Allocation unit size in bytes.
        indexes:
          - labelname: hrStorageIndex
            type: gauge
        lookups:
          - labels:
              - hrStorageIndex
            labelname: hrStorageDescr
            oid: 1.3.6.1.2.1.25.2.3.1.3
            type: DisplayString

      - name: hrStorageSize
        oid: 1.3.6.1.2.1.25.2.3.1.5
        type: gauge
        help: Total size in allocation units.
        indexes:
          - labelname: hrStorageIndex
            type: gauge
        lookups:
          - labels:
              - hrStorageIndex
            labelname: hrStorageDescr
            oid: 1.3.6.1.2.1.25.2.3.1.3
            type: DisplayString

      - name: hrStorageUsed
        oid: 1.3.6.1.2.1.25.2.3.1.6
        type: gauge
        help: Used size in allocation units.
        indexes:
          - labelname: hrStorageIndex
            type: gauge
        lookups:
          - labels:
              - hrStorageIndex
            labelname: hrStorageDescr
            oid: 1.3.6.1.2.1.25.2.3.1.3
            type: DisplayString

      - name: mtxrHlProcessorTemperature
        oid: 1.3.6.1.4.1.14988.1.1.3.11
        type: gauge
        help: Processor temperature in 0.1 Celsius (legacy scalar; RouterOS only, SwOS returns noSuchInstance).

      # Newer mtxrHlSensorTable — reports temperature as a direct integer in Celsius.
      # SwOS (CSS610) exposes ONLY this table (value column, no name); RouterOS
      # (CRS305/CRS310) populates it too with a "cpu-temperature" name. One metric
      # therefore covers every MikroTik switch. Subtree already walked via ...1.1.3.
      - name: mtxrHlSensorValue
        oid: 1.3.6.1.4.1.14988.1.1.3.100.1.3
        type: gauge
        help: MikroTik health sensor value (temperature in Celsius, direct integer).
        indexes:
          - labelname: mtxrHlSensorIndex
            type: gauge
        lookups:
          - labels:
              - mtxrHlSensorIndex
            labelname: mtxrHlSensorName
            oid: 1.3.6.1.4.1.14988.1.1.3.100.1.2
            type: DisplayString

  tplink:
    walk:
      - 1.3.6.1.2.1.1
      - 1.3.6.1.2.1.2.2
      - 1.3.6.1.2.1.31.1.1
    metrics:
      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge
        help: System uptime in hundredths of a second.

      - name: sysDescr
        oid: 1.3.6.1.2.1.1.1
        type: DisplayString
        help: System description.

      - name: sysName
        oid: 1.3.6.1.2.1.1.5
        type: DisplayString
        help: System name.

      - name: sysLocation
        oid: 1.3.6.1.2.1.1.6
        type: DisplayString
        help: System location.

      - name: sysContact
        oid: 1.3.6.1.2.1.1.4
        type: DisplayString
        help: System contact information.

      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: Interface operational state (1=up 2=down 3=testing).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
        enum_values:
          1: up
          2: down
          3: testing
          4: unknown
          5: dormant
          6: notPresent
          7: lowerLayerDown

      - name: ifHCInOctets
        oid: 1.3.6.1.2.1.31.1.1.1.6
        type: counter
        help: Total octets received on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHCOutOctets
        oid: 1.3.6.1.2.1.31.1.1.1.10
        type: counter
        help: Total octets transmitted on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHighSpeed
        oid: 1.3.6.1.2.1.31.1.1.1.15
        type: gauge
        help: Interface speed in Mbps.
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
