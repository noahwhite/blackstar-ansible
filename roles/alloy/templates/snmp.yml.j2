auths:
  public_v2:
    community: {{ mikrotik_snmp_community }}
    version: 2

modules:
  mikrotik:
    walk:
      - 1.3.6.1.2.1.1.3
      - 1.3.6.1.2.1.2.2
      - 1.3.6.1.2.1.31.1.1
      - 1.3.6.1.2.1.25.3.3
      - 1.3.6.1.4.1.14988.1.1.3
    metrics:
      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3
        type: gauge
        help: System uptime in hundredths of a second.

      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: Interface operational state (1=up 2=down 3=testing).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString
        enum_values:
          1: up
          2: down
          3: testing
          4: unknown
          5: dormant
          6: notPresent
          7: lowerLayerDown

      - name: ifHCInOctets
        oid: 1.3.6.1.2.1.31.1.1.1.6
        type: counter
        help: Total octets received on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHCOutOctets
        oid: 1.3.6.1.2.1.31.1.1.1.10
        type: counter
        help: Total octets transmitted on interface (64-bit).
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: ifHighSpeed
        oid: 1.3.6.1.2.1.31.1.1.1.15
        type: gauge
        help: Interface speed in Mbps.
        indexes:
          - labelname: ifIndex
            type: gauge
        lookups:
          - labels:
              - ifIndex
            labelname: ifDescr
            oid: 1.3.6.1.2.1.2.2.1.2
            type: DisplayString

      - name: hrProcessorLoad
        oid: 1.3.6.1.2.1.25.3.3.1.2
        type: gauge
        help: Processor load percentage.
        indexes:
          - labelname: hrDeviceIndex
            type: gauge

      - name: mtxrHlVoltage
        oid: 1.3.6.1.4.1.14988.1.1.3.1
        type: gauge
        help: Board voltage in 0.1V.

      - name: mtxrHlTemperature
        oid: 1.3.6.1.4.1.14988.1.1.3.10
        type: gauge
        help: Board temperature in 0.1 Celsius.

      - name: mtxrHlProcessorTemperature
        oid: 1.3.6.1.4.1.14988.1.1.3.11
        type: gauge
        help: Processor temperature in 0.1 Celsius.

      - name: mtxrHlCurrent
        oid: 1.3.6.1.4.1.14988.1.1.3.12
        type: gauge
        help: Board current in mA.

      - name: mtxrHlPower
        oid: 1.3.6.1.4.1.14988.1.1.3.13
        type: gauge
        help: Power consumption in watts.

      - name: mtxrHlTotalMemory
        oid: 1.3.6.1.4.1.14988.1.1.3.8
        type: gauge
        help: Total memory in KiB.

      - name: mtxrHlFreeMemory
        oid: 1.3.6.1.4.1.14988.1.1.3.9
        type: gauge
        help: Free memory in KiB.

      - name: mtxrHlCpuLoad
        oid: 1.3.6.1.4.1.14988.1.1.3.100
        type: gauge
        help: CPU load percentage (RouterOS 7.x).
