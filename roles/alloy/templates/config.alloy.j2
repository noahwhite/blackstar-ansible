prometheus.exporter.unix "local_system" {
  // Disable collectors whose series no dashboard panel or alert queries, to stay
  // under the Grafana Cloud free-tier 10k active-series cap (NWSOC-21):
  //   softnet      ~864 series  (per-CPU softirq stats)
  //   schedstat    ~324 series  (per-CPU scheduler stats)
  //   thermal_zone ~278 series  (node_cooling_device_*; temps come from hwmon)
  disable_collectors = ["softnet", "schedstat", "thermal_zone"]

  // PCIe AER counters, written by pcie-aer-textfile.timer. node_exporter has no
  // AER collector, and correctable RxErr/BadTLP counts are the leading indicator
  // for the fatal atlantic AERs that drop a node off the Ceph net (PD #29).
  // 42 series/node (14 AER-capable devices x 3 severities) — ~1.3% of the 10k cap.
  textfile {
    directory = "{{ alloy_textfile_dir }}"
  }
}

prometheus.relabel "friendly_names" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Drop high-cardinality node_exporter series unused by any panel/alert, to stay
  // under the Grafana Cloud free-tier 10k active-series cap (NWSOC-21).
  // node_scrape_collector_* : per-collector scrape meta (~600 series).
  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_(duration_seconds|success)"
    action        = "drop"
  }
  // Unused cpufreq series (~648). Keep node_cpu_scaling_frequency_hertz (dashboarded).
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_scaling_governor|node_cpu_frequency_(min|max)_hertz|node_cpu_scaling_frequency_(min|max)_hertz"
    action        = "drop"
  }
  // Drop the 4 unused systemd unit states — only state="failed" is consumed by any
  // dashboard/alert. node_systemd_unit_state emits 5 states x every unit; on the
  // officina CI-runner VMs this is the single largest active-series contributor
  // (~1000 series/runner, mostly the non-failed states) on the shared officina
  // Grafana Cloud tenant, and the churny activating/deactivating states from
  // ephemeral CI job units drive its active-series rejections. Keeping only
  // "failed" cuts ~4 series per unit. The "@" separator lets one regex match the
  // __name__;state pair.
  rule {
    source_labels = ["__name__", "state"]
    separator     = "@"
    regex         = "node_systemd_unit_state@(active|activating|deactivating|inactive)"
    action        = "drop"
  }

  // Unused ZFS series (OFF-1446): 3,231 series across pve01-pve07 (315 of the 321
  // node_zfs_* names), measured 2026-11-08. Keep the six names "Blackstar Node
  // Health" consumes or that report pool health: node_zfs_arc_{size,c_max,c_min,
  // hits,misses} and node_zfs_zpool_state (84 series).
  // Three rules, not one: the relabel regex is RE2, which has no negative
  // lookahead, so "every node_zfs_* name except these six" cannot be one drop
  // regex. Instead, mark the six with a temporary label, drop every unmarked
  // node_zfs_* series (the "@" separator joins __name__ and the mark, which is
  // empty when absent), then remove the mark so kept series leave unchanged.
  rule {
    source_labels = ["__name__"]
    regex         = "node_zfs_(arc_(size|c_max|c_min|hits|misses)|zpool_state)"
    target_label  = "__tmp_zfs_keep"
    replacement   = "1"
  }
  rule {
    source_labels = ["__name__", "__tmp_zfs_keep"]
    separator     = "@"
    regex         = "node_zfs_.*@"
    action        = "drop"
  }
  rule {
    regex  = "__tmp_zfs_keep"
    action = "labeldrop"
  }

  rule {
    source_labels = ["chip"]
    regex         = "target.*"
    target_label  = "chip_alias"
    replacement   = "sata_sda"
  }

  rule {
    source_labels = ["chip"]
    regex         = "nvme_(nvme[0-9]+)"
    target_label  = "chip_alias"
    replacement   = "$1"
  }

  rule {
    source_labels = ["chip"]
    regex         = "platform_coretemp_0"
    target_label  = "chip_alias"
    replacement   = "cpu"
  }

  rule {
    source_labels = ["chip"]
    regex         = "0000:07:00_0_0000:08:00_0"
    target_label  = "chip_alias"
    replacement   = "nic_10g"
  }

  rule {
    source_labels = ["chip"]
    regex         = "wmi_bus_pnp0c14.*"
    target_label  = "chip_alias"
    replacement   = "hp_wmi"
  }
}

prometheus.scrape "node_metrics" {
  targets         = prometheus.exporter.unix.local_system.targets
  forward_to      = [prometheus.relabel.friendly_names.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_remote_write_url }}"

    basic_auth {
      username = "{{ alloy_remote_write_username }}"
      password = "{{ alloy_remote_write_password }}"
    }
  }
}
{% if mikrotik_snmp_targets is defined and mikrotik_snmp_targets | length > 0 %}

prometheus.exporter.snmp "mikrotik" {
  config_file = "/etc/alloy/snmp.yml"
{% for target in mikrotik_snmp_targets %}

  target "{{ target.name }}" {
    address = "{{ target.address }}"
    module  = "mikrotik"
    auth    = "public_v2"
  }
{% endfor %}
}

prometheus.scrape "mikrotik_snmp" {
  targets         = prometheus.exporter.snmp.mikrotik.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "integrations/snmp-mikrotik"

  clustering {
    enabled = {{ alloy_cluster_enabled | default(false) | lower }}
  }
}
{% endif %}
{% if tplink_snmp_targets is defined and tplink_snmp_targets | length > 0 %}

prometheus.exporter.snmp "tplink" {
  config_file = "/etc/alloy/snmp.yml"
{% for target in tplink_snmp_targets %}

  target "{{ target.name }}" {
    address = "{{ target.address }}"
    module  = "tplink"
    auth    = "blackstar_v2"
  }
{% endfor %}
}

prometheus.scrape "tplink_snmp" {
  targets         = prometheus.exporter.snmp.tplink.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "integrations/snmp-tplink"

  clustering {
    enabled = {{ alloy_cluster_enabled | default(false) | lower }}
  }
}
{% endif %}
