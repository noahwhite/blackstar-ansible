prometheus.exporter.unix "local_system" {
  // Disable collectors whose series no dashboard panel or alert queries, to stay
  // under the Grafana Cloud free-tier 10k active-series cap (NWSOC-21):
  //   softnet      ~864 series  (per-CPU softirq stats)
  //   schedstat    ~324 series  (per-CPU scheduler stats)
  //   thermal_zone ~278 series  (node_cooling_device_*; temps come from hwmon)
  disable_collectors = ["softnet", "schedstat", "thermal_zone"]
}

prometheus.relabel "friendly_names" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  // Drop high-cardinality node_exporter series unused by any panel/alert, to stay
  // under the Grafana Cloud free-tier 10k active-series cap (NWSOC-21).
  // node_scrape_collector_* : per-collector scrape meta (~600 series).
  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_(duration_seconds|success)"
    action        = "drop"
  }
  // Unused cpufreq series (~648). Keep node_cpu_scaling_frequency_hertz (dashboarded).
  rule {
    source_labels = ["__name__"]
    regex         = "node_cpu_scaling_governor|node_cpu_frequency_(min|max)_hertz|node_cpu_scaling_frequency_(min|max)_hertz"
    action        = "drop"
  }

  rule {
    source_labels = ["chip"]
    regex         = "target.*"
    target_label  = "chip_alias"
    replacement   = "sata_sda"
  }

  rule {
    source_labels = ["chip"]
    regex         = "nvme_(nvme[0-9]+)"
    target_label  = "chip_alias"
    replacement   = "$1"
  }

  rule {
    source_labels = ["chip"]
    regex         = "platform_coretemp_0"
    target_label  = "chip_alias"
    replacement   = "cpu"
  }

  rule {
    source_labels = ["chip"]
    regex         = "0000:07:00_0_0000:08:00_0"
    target_label  = "chip_alias"
    replacement   = "nic_10g"
  }

  rule {
    source_labels = ["chip"]
    regex         = "wmi_bus_pnp0c14.*"
    target_label  = "chip_alias"
    replacement   = "hp_wmi"
  }
}

prometheus.scrape "node_metrics" {
  targets         = prometheus.exporter.unix.local_system.targets
  forward_to      = [prometheus.relabel.friendly_names.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_remote_write_url }}"

    basic_auth {
      username = "{{ alloy_remote_write_username }}"
      password = "{{ alloy_remote_write_password }}"
    }
  }
}
{% if mikrotik_snmp_targets is defined and mikrotik_snmp_targets | length > 0 %}

prometheus.exporter.snmp "mikrotik" {
  config_file = "/etc/alloy/snmp.yml"
{% for target in mikrotik_snmp_targets %}

  target "{{ target.name }}" {
    address = "{{ target.address }}"
    module  = "mikrotik"
    auth    = "public_v2"
  }
{% endfor %}
}

prometheus.scrape "mikrotik_snmp" {
  targets         = prometheus.exporter.snmp.mikrotik.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "integrations/snmp-mikrotik"

  clustering {
    enabled = {{ alloy_cluster_enabled | default(false) | lower }}
  }
}
{% endif %}
{% if tplink_snmp_targets is defined and tplink_snmp_targets | length > 0 %}

prometheus.exporter.snmp "tplink" {
  config_file = "/etc/alloy/snmp.yml"
{% for target in tplink_snmp_targets %}

  target "{{ target.name }}" {
    address = "{{ target.address }}"
    module  = "tplink"
    auth    = "blackstar_v2"
  }
{% endfor %}
}

prometheus.scrape "tplink_snmp" {
  targets         = prometheus.exporter.snmp.tplink.targets
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "{{ alloy_scrape_interval }}"
  job_name        = "integrations/snmp-tplink"

  clustering {
    enabled = {{ alloy_cluster_enabled | default(false) | lower }}
  }
}
{% endif %}
